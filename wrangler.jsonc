//fil for opptatering av nettsiden boligbergen.site
//akk nå er vil ikke nettsiden opptateres automatisk etter endringer,
//så håvard må kjøre en "npx wrangler deploy" pga nettsiden er knyttet opp mot hans cloudflare
//Kjør fra mappen som inneholder `wrangler.jsonc` (krever Node.js/npm):

//```sh
//npx wrangler login
//npx wrangler deploy
//```

{
  "name": "boligbyen-bergen",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash"
  }
}
